#!/usr/bin/env bash
echo "Workdir : $(pwd)"
workdir=$(pwd)
set -x;
INSTALL_DIR=$(pwd)/install
if [ ! -z "$1" ]; then
    INSTALL_DIR="$1"
    if [ -d "$INSTALL_DIR" ]; then
        mkdir -p "${INSTALL_DIR}"
    fi
fi
if [ -d "$INSTALL_DIR" ]; then
    mkdir -p "${INSTALL_DIR}"
fi

if [ -f ${workdir}/configure ]; then
    echo "Please use (cd) to choose another directory and run $0 again";
    exit 1;
fi
cmake $(dirname $0) "-DCMAKE_INSTALL_PREFIX=${INSTALL_DIR}"
